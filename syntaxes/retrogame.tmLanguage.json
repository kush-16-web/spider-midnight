{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Retro Game Code",
  "scopeName": "source.game",
  "patterns": [
    { "include": "#comments" },
    { "include": "#stage-headers" },
    { "include": "#arcade-stats" },
    { "include": "#arcade-commands" },
    { "include": "#strings" },
    { "include": "#functions" },
    { "include": "#brackets" },
    { "include": "#parentheses" },
    { "include": "#numbers" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.retro",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.retro",
          "match": "#.*$"
        },
        {
          "name": "comment.line.semicolon.retro",
          "match": ";.*$"
        },
        {
          "name": "comment.block.retro",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "stage-headers": {
      "patterns": [
        {
          "name": "keyword.control.stage.retro",
          "match": "^\\[(?:LEVEL|STAGE|WORLD|MAP|ZONE|BOSS)\\s*[^\\]]*\\]"
        }
      ]
    },
    "arcade-stats": {
      "patterns": [
        {
          "name": "variable.other.stat.retro",
          "match": "\\b(1UP|2UP|SCORE|HIGHSCORE|LIVES|CREDITS|HEALTH|HP|MP|EXP|POWER|COINS|KEYS|SPEED|TIME|PLAYER)\\b"
        }
      ]
    },
    "arcade-commands": {
      "patterns": [
        {
          "name": "keyword.control.action.retro",
          "match": "\\b(PRESS START|INSERT COIN|GAME OVER|CONTINUE|READY|PAUSE|FIRE|JUMP|ATTACK|DEFEND|UP|DOWN|LEFT|RIGHT|A|B|X|Y|SELECT|START)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.retro",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.retro",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.retro",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.retro",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.retro"
            }
          }
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.definition.bracket.curly.retro",
          "match": "[\\{\\}]"
        },
        {
          "name": "punctuation.definition.bracket.square.retro",
          "match": "[\\[\\]]"
        }
      ]
    },
    "parentheses": {
      "patterns": [
        {
          "name": "punctuation.definition.bracket.round.retro",
          "match": "[\\(\\)]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.retro",
          "match": "\\b0x[0-9A-Fa-f]+\\b|\\b\\d+\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.retro",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
