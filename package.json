{
  "name": "spider-midnight-theme",
  "displayName": "Spider Midnight - Aesthetic Dark Theme & Live Weather Companion",
  "description": "Modern atmospheric Spider-Man Midnight environment for VS Code with live real-time local weather companion, Comic Mono font, multi-color syntax, and custom spider icons.",
  "version": "1.0.5",
  "publisher": "kushpandya",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kush-16-web/spider-midnight"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes",
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:antigravity.mode.superhero",
    "onCommand:antigravity.mode.retro",
    "onCommand:antigravity.mode.spiderman",
    "onCommand:antigravity.font.install",
    "onCommand:antigravity.spiderCompanion.toggle",
    "onCommand:antigravity.spider.commit",
    "onView:antigravity.spiderCompanionView"
  ],
  "contributes": {
    "configurationDefaults": {
      "[Spider-Man Midnight]": {
        "editor.fontFamily": "'Comic Mono', monospace",
        "editor.fontWeight": "normal",
        "editor.fontSize": 14,
        "editor.fontLigatures": false,
        "editor.lineHeight": 24
      },
      "[Antigravity Superhero]": {
        "editor.fontFamily": "'Comic Mono', 'Courier New', 'Courier', monospace",
        "editor.fontWeight": "bold",
        "editor.fontSize": 14,
        "editor.fontLigatures": false,
        "editor.lineHeight": 24
      },
      "[Antigravity Retro Arcade]": {
        "editor.fontFamily": "'VT323', 'Press Start 2P', 'Courier New', monospace",
        "editor.fontWeight": "normal",
        "editor.fontSize": 18,
        "editor.fontLigatures": false,
        "editor.lineHeight": 28
      },
      "[superhero-code]": {
        "editor.fontFamily": "'Comic Mono', monospace"
      },
      "[retrogame-code]": {
        "editor.fontFamily": "'VT323', 'Press Start 2P', monospace"
      }
    },
    "configuration": {
      "title": "Antigravity Hero Retro",
      "properties": {
        "antigravity.mode": {
          "type": "string",
          "enum": [
            "superhero",
            "retro",
            "spiderman"
          ],
          "enumDescriptions": [
            "Catppuccin Superhero pastel palette, hero file icons, bold Comic Mono font.",
            "Catppuccin Retro Arcade Macchiato palette, pixel gamepad icons, 8-bit VT323 / Press Start 2P font.",
            "Eye-comfy Spider-Man Midnight palette, spider emblem file icons, web-string attribute scopes, solid matte charcoal panels."
          ],
          "default": "spiderman",
          "markdownDescription": "Active visual preset. Changing this value instantly swaps the color theme, file icon theme, and editor font."
        }
      }
    },
    "views": {
      "panel": [
        {
          "type": "webview",
          "id": "antigravity.spiderCompanionView",
          "name": "Ambient Companion"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity.spiderCompanion.toggle",
        "title": "Antigravity: Focus Ambient Companion Tray",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.mode.superhero",
        "title": "Antigravity: Switch to Superhero Mode",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.mode.retro",
        "title": "Antigravity: Switch to Retro Game Mode",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.mode.spiderman",
        "title": "Antigravity: Switch to Spider-Man Midnight Mode",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.font.install",
        "title": "Antigravity: Install Bundled 8-Bit Fonts to This Machine",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.spider.commit",
        "title": "Spider-Man: Commit Staged Changes (Web Strike)",
        "icon": "./icons/spiderman/spider-web-action.svg",
        "category": "Spider-Man"
      }
    ],
    "menus": {
      "scm/inputBox": [
        {
          "command": "antigravity.spider.commit",
          "group": "inline"
        }
      ],
      "scm/title": [
        {
          "command": "antigravity.spider.commit",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "superhero-code",
        "aliases": [
          "Superhero Code",
          "superhero-code"
        ],
        "extensions": [
          ".hero",
          ".marvel"
        ],
        "configuration": "./languages/superhero-language-configuration.json"
      },
      {
        "id": "retrogame-code",
        "aliases": [
          "Retro Game Code",
          "retrogame-code"
        ],
        "extensions": [
          ".game",
          ".retro"
        ],
        "configuration": "./languages/retrogame-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "superhero-code",
        "scopeName": "source.hero",
        "path": "./syntaxes/superhero.tmLanguage.json"
      },
      {
        "language": "retrogame-code",
        "scopeName": "source.game",
        "path": "./syntaxes/retrogame.tmLanguage.json"
      },
      {
        "scopeName": "react.tag.custom.injection",
        "path": "./syntaxes/react-components.tmLanguage.json",
        "injectTo": [
          "source.tsx",
          "source.jsx",
          "text.html.basic"
        ]
      }
    ],
    "iconThemes": [
      {
        "id": "antigravity-hero-icons",
        "label": "Antigravity Superhero Icons",
        "path": "./icons/superhero/icon-theme.json"
      },
      {
        "id": "antigravity-retro-icons",
        "label": "Antigravity Retro Gamepad Icons",
        "path": "./icons/retro/icon-theme.json"
      },
      {
        "id": "antigravity-spiderman-icons",
        "label": "Antigravity Spider-Man Emblem Icons",
        "path": "./icons/spiderman/icon-theme.json"
      }
    ],
    "themes": [
      {
        "label": "Antigravity Superhero",
        "uiTheme": "vs-dark",
        "path": "./themes/catppuccin-superhero-theme.json"
      },
      {
        "label": "Antigravity Retro Arcade",
        "uiTheme": "vs-dark",
        "path": "./themes/catppuccin-retro-arcade-theme.json"
      },
      {
        "label": "Spider-Man Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/spiderman-midnight-theme.json"
      }
    ]
  }
}